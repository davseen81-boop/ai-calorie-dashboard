# ---------------------------------------------------------------------------
# AI Calorie Tracking Dashboard — environment template
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Project URL and anon key are safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key bypasses RLS. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Used only by route handlers that must act outside a user session.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=

# Model used to parse free-text meal descriptions.
OPENAI_TEXT_MODEL=gpt-4o
# Model used for photo (vision) meal analysis.
OPENAI_VISION_MODEL=gpt-4o

# --- App --------------------------------------------------------------------
# Public origin, used for Supabase OAuth redirect callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
