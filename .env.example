# ---------------------------------------------------------------------------
# AI Calorie Tracking Dashboard — environment template
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# --- Database (libSQL / SQLite) ---------------------------------------------
# Local development: a plain SQLite file. Nothing to sign up for.
DATABASE_URL=file:./local.db

# Deploying to Vercel: a SQLite file will NOT work there — serverless storage
# is ephemeral, so writes are lost on every cold start and each instance gets
# its own copy. Use Turso instead (same SQLite engine, reachable over HTTP):
#
#   DATABASE_URL=libsql://<your-db>-<your-org>.turso.io
#   DATABASE_AUTH_TOKEN=<from `turso db tokens create <your-db>`>
#
# Leave the token blank for local file usage.
DATABASE_AUTH_TOKEN=

# --- AI provider ------------------------------------------------------------
# Which AI analyses meals: "gemini" (default) or "anthropic".
# Only the selected provider's key is needed.
AI_PROVIDER=gemini

# --- Google Gemini (free tier) ----------------------------------------------
# Free key, no card required: https://aistudio.google.com/apikey
# Multimodal, so both text and photo analysis work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Anthropic (Claude) — only if AI_PROVIDER=anthropic ----------------------
# Paid: https://console.anthropic.com/settings/keys (requires prepaid credits;
# a Claude.ai subscription does NOT include API access).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Accounts ---------------------------------------------------------------
# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional. When set, creating an account requires this code — including via
# Google. Leave blank to allow anyone with the URL to sign up.
SIGNUP_INVITE_CODE=

# Optional Google sign-in. Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and register these exact
# redirect URIs:
#   http://localhost:3000/api/auth/google/callback
#   https://<your-domain>/api/auth/google/callback
# Leave blank to hide the Google button entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
